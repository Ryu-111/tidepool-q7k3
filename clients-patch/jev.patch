+  // Record how the user corrects the result: which fields they edit, clear or fill by hand.
+  // Only the field's page text and the decided kind are kept, in the extension's own storage
+  // (never a cookie or page storage, which the site could read); typed values are never stored.
+  const feedback = (request.feedback ?? []).filter(
+    (row) =>
+      state.nodes[row.id] &&
+      state.nodes[row.id].field.type.toLowerCase() !== "password" &&
+      state.nodes[row.id].node.type !== "password" &&
+      (written.some((e) => e.id === row.id) || state.nodes[row.id].value === ""),
+  );
+  if (storage && initialSettings !== null && feedback.length) {
+    const fill = crypto.randomUUID();
+    const until = Date.now() + 30 * 60_000;
+    // One registry entry owns every listener and the expiry timer for this fill.
+    const listeners: (() => void)[] = [];
+    let stopped = false;
+    const stop = () => {
+      stopped = true;
+      clearTimeout(timer);
+      for (const remove of listeners) {
+        remove();
+      }
+      if (root.__jevFeedback === stop) {
+        delete root.__jevFeedback;
+      }
+    };
+    const timer = setTimeout(stop, 30 * 60_000);
+    root.__jevFeedback = stop;
+    // Keep the fill before its edits, even when storage operations complete asynchronously.
+    let pending = Promise.resolve();
+    // The fill id plus a zero-padded sequence keeps keys unique within one millisecond.
+    let sequence = 0;
+    const put = (record: Record<string, unknown>) => {
+      const order = String(sequence++).padStart(6, "0");
+      const key = `jev.feedback.${String(Date.now())}.${fill}.${order}`;
+      pending = pending
+        .then(() => initialSettings)
+        .then((initial) => {
+          if (stopped || !initial || initial["jev.feedbackEnabled"] === false) {
+            stop();
+            return;
+          }
+          return storage.get(settingsKeys).then((current) => {
+            if (
+              stopped ||
+              Date.now() >= until ||
+              location.href !== state.url ||
+              current["jev.feedbackEnabled"] === false ||
+              (current["jev.feedbackGeneration"] ?? 0) !== (initial["jev.feedbackGeneration"] ?? 0)
+            ) {
+              stop();
+              return;
+            }
+            return storage.set({ [key]: { v: 1, fill, ...record } });
+          });
+        })
+        .catch(() => stop());
+    };
+    put({
+      type: "fill",
+      at: Date.now(),
+      origin: new URL(state.url).origin,
+      fields: feedback.map((row) => ({
+        ...row,
+        filled: written.some((e) => e.id === row.id),
+        field: state.nodes[row.id].field,
+      })),
+    });
+    for (const row of feedback) {
+      const node = state.nodes[row.id].node;
+      const expected = written.find((e) => e.id === row.id)?.value ?? "";
+      const onChange = (event: Event) => {
+        if (stopped || Date.now() >= until || location.href !== state.url) {
+          stop();
+          return;
+        }
+        if (!event.isTrusted) {
+          return; // Page scripts (postcode widgets) are not the user's correction.
+        }
+        const outcome =
+          node.value === expected
+            ? "kept"
+            : expected === ""
+              ? "typed"
+              : node.value === ""
+                ? "cleared"
+                : "edited";
+        put({ type: "edit", at: Date.now(), id: row.id, outcome });
+      };
+      node.addEventListener("change", onChange);
+      listeners.push(() => node.removeEventListener("change", onChange));
+    }
+  }
+  // Detect delayed postcode widgets; report drift instead of silently writing again.
+  return new Promise((resolve) =>
+    setTimeout(() => {
+      const changed = written.filter((entry) => {
+        const node = state.nodes[entry.id].node;
+        return location.href !== state.url || !visible(node) || node.value !== entry.value;
+      }).length;
+      resolve({ token: "", url: state.url, fields: [], written: written.length, changed });
+    }, 1000),
+  );
+}
diff --git a/apps/browser/src/autofill/popup/jev/jev.component.html b/apps/browser/src/autofill/popup/jev/jev.component.html
