+import { ChangeDetectorRef } from "@angular/core";
+import { mock } from "jest-mock-extended";
+import { BehaviorSubject, of } from "rxjs";
+
+import { AccountService } from "@bitwarden/common/auth/abstractions/account.service";
+import { AuthService } from "@bitwarden/common/auth/abstractions/auth.service";
+import { AuthenticationStatus } from "@bitwarden/common/auth/enums/authentication-status";
+import { DomainSettingsService } from "@bitwarden/common/autofill/services/domain-settings.service";
+import { UriMatchStrategy } from "@bitwarden/common/models/domain/domain-service";
+import { UserId } from "@bitwarden/common/types/guid";
+import { CipherService } from "@bitwarden/common/vault/abstractions/cipher.service";
+import { CipherRepromptType, CipherType } from "@bitwarden/common/vault/enums";
+import { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+import { PasswordRepromptService } from "@bitwarden/vault";
+
+import { BrowserApi } from "../../../platform/browser/browser-api";
+
+import { JevComponent } from "./jev.component";
+
+const pageField = (id: number, caption: string, occupied = false) => ({
+  id,
+  type: "text",
+  labels: [caption],
+  caption,
+  ariaLabel: "",
+  placeholder: "",
+  name: "",
+  htmlId: "",
+  context: "",
+  group: "",
+  autocomplete: "",
+  maxLength: -1,
+  options: [] as { value: string; label: string }[],
+  occupied,
+});
+
+describe("Jev vault boundary", () => {
+  const accountId = "00000000-0000-0000-0000-000000000001" as UserId;
+  const tab = { id: 12, url: "https://profile.example/form" } as chrome.tabs.Tab;
+  const identity = {
+    id: "identity",
+    name: "Dummy",
+    isDeleted: false,
+    isArchived: false,
+    type: CipherType.Identity,
+    reprompt: CipherRepromptType.None,
+    identity: { lastName: "試験" },
+    fields: [],
+  } as unknown as CipherView;
+  let component: JevComponent;
+  let status: BehaviorSubject<AuthenticationStatus>;
+  let blocked: BehaviorSubject<Record<string, null>>;
+  let ciphers: ReturnType<typeof mock<CipherService>>;
+  let reprompt: ReturnType<typeof mock<PasswordRepromptService>>;
+  let execute: jest.SpyInstance;
+
+  beforeEach(async () => {
+    status = new BehaviorSubject(AuthenticationStatus.Unlocked);
+    blocked = new BehaviorSubject<Record<string, null>>({});
+    const accounts = mock<AccountService>();
+    Object.defineProperty(accounts, "activeAccount$", { value: of({ id: accountId }) });
+    const auth = mock<AuthService>();
+    Object.defineProperty(auth, "activeAccountStatus$", { value: status });
+    const domains = mock<DomainSettingsService>();
+    Object.defineProperty(domains, "blockedInteractionsUris$", { value: blocked });
+    ciphers = mock<CipherService>();
+    ciphers.getAllDecrypted.mockResolvedValue([identity]);
+    ciphers.getAllDecryptedForIds.mockResolvedValue([identity]);
+    reprompt = mock<PasswordRepromptService>();
+    jest.spyOn(BrowserApi, "getTabFromCurrentWindow").mockResolvedValue(tab);
+    jest.spyOn(BrowserApi, "getTab").mockResolvedValue(tab);
+    execute = jest.spyOn(BrowserApi, "executeFunctionInTab").mockResolvedValue({
+      token: "nonce",
+      url: tab.url,
+      fields: [pageField(0, "姓")],
+      written: 0,
+      changed: 0,
+    });
+    component = new JevComponent(
+      accounts,
+      auth,
+      ciphers,
+      domains,
+      reprompt,
+      mock<ChangeDetectorRef>(),
+    );
+    component.options.autoFillOnOpen = false;
+    component.keyStore.get = jest.fn().mockResolvedValue("");
+    component.ngOnInit();
+    for (let i = 0; i < 30; i++) {
+      await Promise.resolve();
+    }
+    component.state.identityId = "identity";
+  });
+  afterEach(() => {
+    component.ngOnDestroy();
+    jest.restoreAllMocks();
+  });
+
+  it.each([
+    ["https://profile.example/login", null, true],
+    ["http://profile.example/login", null, false],
+    ["https://profile.example:8443/login", null, false],
+    ["https://profile.example.evil.test/login", null, false],
+    ["https://profile.example/form", UriMatchStrategy.Never, false],
+    ["https://profile.example/login", UriMatchStrategy.Exact, false],
+    ["https://profile.example/form", UriMatchStrategy.Exact, true],
+  ])("checks the saved login URI %s / %s", async (uri, match, allowed) => {
+    component.state.loginId = "login";
+    ciphers.getAllDecryptedForIds.mockResolvedValue([
+      identity,
+      {
+        id: "login",
+        type: CipherType.Login,
+        viewPassword: true,
+        reprompt: CipherRepromptType.None,
+        login: { username: "synthetic", password: "synthetic", uris: [{ uri, match }] },
+      } as CipherView,
+    ]);
+    await component.prepare();
+    expect(execute.mock.calls.some((call) => call[2]?.[0]?.action === "collect")).toBe(allowed);
+  });
+  it("starts with no approved fields", async () => {
+    await component.prepare();
+    expect(component.state.rows[0].value).toBe("試験");
+    expect(component.state.rows[0].approved).toBe(false);
+  });
+  it("drops prepared values and the API key on lock", async () => {
+    await component.prepare();
+    component.state.apiKey = "synthetic-key";
+    status.next(AuthenticationStatus.Locked);
+    expect(component.state.rows).toEqual([]);
+    expect(component.state.apiKey).toBe("");
+    execute.mockClear();
+    await component.fill();
+    expect(execute).not.toHaveBeenCalled();
+  });
+  it("honors a blocklist change before filling", async () => {
+    await component.prepare();
+    component.state.rows[0].approved = true;
+    blocked.next({ "profile.example": null });
+    execute.mockClear();
+    await component.fill();
+    expect(execute.mock.calls.some((call) => call[2]?.[0]?.action === "fill")).toBe(false);
+  });
+  it("honors a cancelled master password reprompt", async () => {
+    ciphers.getAllDecryptedForIds.mockResolvedValue([
+      { ...identity, reprompt: CipherRepromptType.Password } as CipherView,
+    ]);
+    reprompt.showPasswordPrompt.mockResolvedValue(false);
+    await component.prepare();
+    expect(component.state.rows).toEqual([]);
+    expect(execute).not.toHaveBeenCalled();
+  });
+  it.each(["deleted", "edited", "reprompt"])(
+    "rejects a %s vault item after preparation",
+    async (change) => {
+      await component.prepare();
+      component.state.rows[0].approved = true;
+      ciphers.getAllDecryptedForIds.mockResolvedValue([
+        {
+          ...identity,
+          isDeleted: change === "deleted",
+          identity: { ...identity.identity, lastName: change === "edited" ? "変更" : "試験" },
+          reprompt: change === "reprompt" ? CipherRepromptType.Password : CipherRepromptType.None,
+        } as CipherView,
+      ]);
+      execute.mockClear();
+      await component.fill();
+      expect(execute.mock.calls.some((call) => call[2]?.[0]?.action === "fill")).toBe(false);
+    },
+  );
+  it("fills only approved rows when the vault and page remain unchanged", async () => {
+    await component.prepare();
+    component.state.rows[0].approved = true;
+    execute.mockClear();
+    await component.fill();
+    expect(
+      execute.mock.calls.find((call) => call[2]?.[0]?.action === "fill")?.[2][0].entries,
+    ).toEqual([{ id: 0, value: "試験", overwrite: false }]);
+    expect(component.state.rows).toEqual([]);
+  });
+  it("quick fill writes every recognized empty field and leaves filled ones alone", async () => {
+    execute.mockResolvedValueOnce({
+      token: "nonce",
+      url: tab.url,
+      fields: [pageField(0, "姓"), pageField(1, "姓", true), pageField(2, "備考")],
+      written: 0,
+      changed: 0,
+    });
+    await component.quickFill();
+    const fill = execute.mock.calls.find((call) => call[2]?.[0]?.action === "fill");
+    expect(fill?.[2][0].entries).toEqual([{ id: 0, value: "試験", overwrite: false }]);
+    expect(component.state.filled).toEqual(["姓"]);
+    expect(component.state.skipped).toEqual(["姓（入力済みのため変更せず）", "備考（判定できず）"]);
+    expect(component.state.jevNote).toContain("キーが未設定");
+  });
+  it("fills on open when there is a single profile", async () => {
+    execute.mockClear();
+    const opened = new JevComponent(
+      (component as unknown as { accounts: AccountService }).accounts,
+      (component as unknown as { auth: AuthService }).auth,
+      ciphers,
+      (component as unknown as { domains: DomainSettingsService }).domains,
+      reprompt,
+      mock<ChangeDetectorRef>(),
+    );
+    opened.ngOnInit();
+    for (let i = 0; i < 60; i++) {
+      await Promise.resolve();
+    }
+    expect(opened.state.identityId).toBe("identity");
+    expect(execute.mock.calls.some((call) => call[2]?.[0]?.action === "fill")).toBe(true);
+    opened.ngOnDestroy();
+  });
+  it("asks the page to record corrections unless recording is off", async () => {
+    for (const enabled of [true, false]) {
+      component.state.feedback.enabled = enabled;
+      await component.prepare();
+      component.state.rows[0].approved = true;
+      execute.mockClear();
+      await component.fill();
+      const request = execute.mock.calls.find((call) => call[2]?.[0]?.action === "fill")?.[2][0];
+      expect(request.feedback).toEqual(
+        enabled ? [{ id: 0, kind: "FAMILY", source: "local", confidence: null }] : undefined,
+      );
+    }
+  });
+  it("summarizes recorded corrections and prunes nothing below the limit", async () => {
+    const remove = jest.fn().mockResolvedValue(undefined);
+    component.feedbackStore.remove = remove;
+    component.feedbackStore.all = jest.fn().mockResolvedValue({
+      "jev.feedback.1.a": {
+        v: 1,
+        fill: "f",
+        type: "fill",
+        fields: [
+          {
+            id: 0,
+            kind: "FAMILY",
+            source: "jev",
+            confidence: 0.95,
+            filled: true,
+            field: { caption: "お名前" },
+          },
+        ],
+      },
+      "jev.feedback.2.b": { v: 1, fill: "f", type: "edit", id: 0, outcome: "edited" },
+      "jev.feedbackEnabled": false,
+    });
+    await component.loadFeedback();
+    expect(remove).toHaveBeenCalledWith([]);
+    expect(component.state.feedback.enabled).toBe(false);
+    expect(component.state.feedback.stats?.bySource.jev).toEqual({
+      filled: 1,
+      edited: 1,
+      cleared: 0,
+    });
+    expect(component.state.feedback.recent).toEqual([
+      { label: "お名前", kind: "FAMILY", source: "jev", outcome: "edited" },
+    ]);
+  });
+  it("omits password rows from correction feedback", async () => {
+    execute.mockResolvedValueOnce({
+      token: "nonce",
+      url: tab.url,
+      fields: [pageField(0, "姓"), { ...pageField(1, "パスワード"), type: "password" }],
+      written: 0,
+      changed: 0,
+    });
+    await component.prepare();
+    component.state.rows[0].approved = true;
+    execute.mockClear();
+    await component.fill();
+    const request = execute.mock.calls.find((call) => call[2]?.[0]?.action === "fill")?.[2][0];
+    expect(request.feedback).toEqual([
+      { id: 0, kind: "FAMILY", source: "local", confidence: null },
+    ]);
+  });
+  it("displays only outcomes retained after pruning whole fills", async () => {
+    const records: Record<string, unknown> = {};
+    for (let i = 0; i < 1501; i++) {
+      records[`jev.feedback.${i + 1}.f${i}.0`] = {
+        v: 1,
+        fill: `f${i}`,
+        type: "fill",
+        fields: [
+          { id: 0, kind: "FAMILY", source: "local", filled: true, field: { caption: "姓" } },
+        ],
+      };
+      records[`jev.feedback.${i + 2000}.f${i}.1`] = {
+        v: 1,
