diff --git a/apps/browser/src/autofill/jev/jev-feedback.spec.ts b/apps/browser/src/autofill/jev/jev-feedback.spec.ts
new file mode 100644
index 0000000..4e421b1
--- /dev/null
+++ b/apps/browser/src/autofill/jev/jev-feedback.spec.ts
@@ -0,0 +1,137 @@
+import {
+  FEEDBACK_PREFIX,
+  feedbackKeys,
+  fieldLabel,
+  outcomes,
+  overflowKeys,
+  stats,
+} from "./jev-feedback";
+
+const field = (caption: string) => ({
+  type: "text",
+  caption,
+  ariaLabel: "",
+  placeholder: "",
+  name: "",
+  htmlId: "",
+  context: "",
+  group: "",
+  autocomplete: "",
+  maxLength: -1,
+  options: [] as string[],
+});
+const row = (
+  id: number,
+  kind: string,
+  source: string,
+  filled: boolean,
+  confidence: number | null = null,
+) => ({
+  id,
+  kind,
+  source,
+  confidence,
+  filled,
+  field: field(`欄${id}`),
+});
+
+describe("Jev correction records", () => {
+  const items: Record<string, unknown> = {
+    [`${FEEDBACK_PREFIX}100.a`]: {
+      v: 1,
+      fill: "f1",
+      type: "fill",
+      at: 100,
+      origin: "https://shop.example",
+      fields: [
+        row(0, "FAMILY", "local", true),
+        row(1, "AFTER_MUNICIPALITY", "jev", true, 0.7),
+        row(2, "UNKNOWN", "none", false),
+        row(3, "EMAIL", "local", true),
+      ],
+    },
+    [`${FEEDBACK_PREFIX}200.b`]: { v: 1, fill: "f1", type: "edit", id: 1, outcome: "edited" },
+    [`${FEEDBACK_PREFIX}300.c`]: { v: 1, fill: "f1", type: "edit", id: 2, outcome: "typed" },
+    [`${FEEDBACK_PREFIX}400.d`]: { v: 1, fill: "f1", type: "edit", id: 3, outcome: "cleared" },
+    [`${FEEDBACK_PREFIX}500.e`]: { v: 1, fill: "f1", type: "edit", id: 3, outcome: "kept" },
+    [`${FEEDBACK_PREFIX}600.f`]: { v: 1, fill: "f1", type: "edit", id: 0, outcome: "bogus" },
+    [`${FEEDBACK_PREFIX}700.g`]: {
+      v: 2,
+      fill: "f2",
+      type: "fill",
+      fields: [row(0, "X", "local", true)],
+    },
+    [`${FEEDBACK_PREFIX}800.h`]: "not a record",
+    "jev.openrouterApiKey": "never read here",
+  };
+
+  it("keeps the last change of each field and ignores malformed records", () => {
+    const list = outcomes(items);
+    expect(list.map((o) => [o.id, o.outcome])).toEqual([
+      [3, "kept"],
+      [2, "typed"],
+      [1, "edited"],
+      [0, "kept"],
+    ]);
+    expect(list.find((o) => o.id === 1)?.confidence).toBe(0.7);
+    expect(fieldLabel(list[0])).toBe("欄3");
+  });
+
+  it("counts corrections per decision source", () => {
+    expect(stats(outcomes(items))).toEqual({
+      fills: 1,
+      bySource: {
+        local: { filled: 2, edited: 0, cleared: 0 },
+        jev: { filled: 1, edited: 1, cleared: 0 },
+      },
+      typed: 1,
+    });
+  });
+
+  it("orders keys by time and drops the oldest beyond the limit", () => {
+    const keys = {
+      [`${FEEDBACK_PREFIX}20.x`]: 1,
+      [`${FEEDBACK_PREFIX}3.y`]: 1,
+      [`${FEEDBACK_PREFIX}100.z`]: 1,
+      other: 1,
+    };
+    expect(feedbackKeys(keys)).toEqual([
+      `${FEEDBACK_PREFIX}3.y`,
+      `${FEEDBACK_PREFIX}20.x`,
+      `${FEEDBACK_PREFIX}100.z`,
+    ]);
+    expect(overflowKeys(keys, 2)).toEqual([`${FEEDBACK_PREFIX}3.y`]);
+    expect(overflowKeys(keys, 5)).toEqual([]);
+  });
+  it("rejects password descriptors including their edit records", () => {
+    const password = row(0, "PASSWORD", "none", false);
+    password.field.type = "PASSWORD";
+    expect(
+      outcomes({
+        "jev.feedback.1.a": { v: 1, fill: "f", type: "fill", fields: [password] },
+        "jev.feedback.2.b": { v: 1, fill: "f", type: "edit", id: 0, outcome: "typed" },
+      }),
+    ).toEqual([]);
+  });
+  it("prunes whole fills including newer edits before retaining the next fill", () => {
+    const records = {
+      "jev.feedback.1.a.0": {
+        v: 1,
+        fill: "a",
+        type: "fill",
+        fields: [row(0, "FAMILY", "local", true)],
+      },
+      "jev.feedback.2.b.0": {
+        v: 1,
+        fill: "b",
+        type: "fill",
+        fields: [row(0, "FAMILY", "local", true)],
+      },
+      "jev.feedback.3.b.1": { v: 1, fill: "b", type: "edit", id: 0, outcome: "edited" },
+      "jev.feedback.4.a.1": { v: 1, fill: "a", type: "edit", id: 0, outcome: "cleared" },
+    };
+    expect(overflowKeys(records, 3)).toEqual(["jev.feedback.1.a.0", "jev.feedback.4.a.1"]);
+    expect(overflowKeys(records, 1)).toEqual(Object.keys(records).sort());
+    expect(overflowKeys(records, 0)).toHaveLength(4);
+  });
+});
diff --git a/apps/browser/src/autofill/jev/jev-feedback.ts b/apps/browser/src/autofill/jev/jev-feedback.ts
new file mode 100644
index 0000000..e83530e
--- /dev/null
+++ b/apps/browser/src/autofill/jev/jev-feedback.ts
@@ -0,0 +1,201 @@
+// Reads the correction records jevPage writes to chrome.storage.local after a fill, and turns
+// them into one outcome per field: kept, edited, cleared, or typed (left empty, filled by hand).
+// Records hold the field's page text and the decided kind, never what the user typed.
+
+export const FEEDBACK_PREFIX = "jev.feedback.";
+export const FEEDBACK_ENABLED_KEY = "jev.feedbackEnabled";
+export const FEEDBACK_GENERATION_KEY = "jev.feedbackGeneration";
+/** Records kept; older ones are dropped when the popup opens. */
+export const FEEDBACK_LIMIT = 3000;
+
+export type JevOutcome = "kept" | "edited" | "cleared" | "typed";
+type Source = "local" | "jev" | "none";
+
+export interface JevFeedbackField {
+  type: string;
+  caption: string;
+  ariaLabel: string;
+  placeholder: string;
+  name: string;
+  htmlId: string;
+  context: string;
+  group: string;
+  autocomplete: string;
+  maxLength: number;
+  options: string[];
+}
+
+export interface JevFieldOutcome {
+  fill: string;
+  at: number;
+  origin: string;
+  id: number;
+  kind: string;
+  source: Source;
+  confidence: number | null;
+  filled: boolean;
+  outcome: JevOutcome;
+  field: JevFeedbackField;
+}
+
+export interface JevFeedbackStats {
+  fills: number;
+  /** Per decision source: fields written, and how many of those the user changed. */
+  bySource: Record<"local" | "jev", { filled: number; edited: number; cleared: number }>;
+  /** Fields left empty that the user filled by hand. */
+  typed: number;
+}
+
+const OUTCOMES: readonly unknown[] = ["kept", "edited", "cleared", "typed"];
+const SOURCES: readonly unknown[] = ["local", "jev", "none"];
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+const str = (value: unknown): string => (typeof value === "string" ? value.slice(0, 200) : "");
+
+function pageField(value: unknown): JevFeedbackField | null {
+  if (!isRecord(value) || str(value.type).toLowerCase() === "password") {
+    return null;
+  }
+  return {
+    type: str(value.type),
+    caption: str(value.caption),
+    ariaLabel: str(value.ariaLabel),
+    placeholder: str(value.placeholder),
+    name: str(value.name),
+    htmlId: str(value.htmlId),
+    context: str(value.context),
+    group: str(value.group),
+    autocomplete: str(value.autocomplete),
+    maxLength: typeof value.maxLength === "number" ? value.maxLength : -1,
+    options: Array.isArray(value.options) ? value.options.slice(0, 20).map(str) : [],
+  };
+}
+
+/** Feedback keys, oldest first (keys embed the write time). */
+export function feedbackKeys(items: Record<string, unknown>): string[] {
+  const time = (key: string) => Number(key.slice(FEEDBACK_PREFIX.length).split(".")[0]) || 0;
+  return Object.keys(items)
+    .filter((key) => key.startsWith(FEEDBACK_PREFIX))
+    .sort((a, b) => time(a) - time(b) || a.localeCompare(b));
+}
+
+/** Keys to remove so that at most [limit] records remain. */
+export function overflowKeys(items: Record<string, unknown>, limit = FEEDBACK_LIMIT): string[] {
+  const keys = feedbackKeys(items);
+  const fills = new Map<string, { keys: string[]; first: string; fillKey?: string }>();
+  for (const key of keys) {
+    const record = items[key];
+    const id = isRecord(record) && typeof record.fill === "string" ? record.fill : key;
+    const group = fills.get(id) ?? { keys: [], first: key };
+    group.keys.push(key);
+    if (isRecord(record) && record.type === "fill") {
+      group.fillKey ??= key;
+    }
+    fills.set(id, group);
+  }
+  const order = new Map(keys.map((key, index) => [key, index]));
+  const groups = [...fills.values()].sort(
+    (a, b) => order.get(a.fillKey ?? a.first)! - order.get(b.fillKey ?? b.first)!,
+  );
+  const removed = new Set<string>();
+  let remaining = keys.length;
+  for (const group of groups) {
+    if (remaining <= limit) {
+      break;
+    }
+    group.keys.forEach((key) => removed.add(key));
+    remaining -= group.keys.length;
+  }
+  return keys.filter((key) => removed.has(key));
+}
+
+function fillOutcomes(record: Record<string, unknown>, fill: string): JevFieldOutcome[] {
+  const fields = Array.isArray(record.fields) ? record.fields : [];
+  return fields.flatMap((raw: unknown) => {
+    const field = isRecord(raw) ? pageField(raw.field) : null;
+    if (
+      !isRecord(raw) ||
+      !field ||
+      typeof raw.id !== "number" ||
+      typeof raw.kind !== "string" ||
+      !SOURCES.includes(raw.source)
+    ) {
+      return [];
+    }
+    return [
+      {
+        fill,
+        at: typeof record.at === "number" ? record.at : 0,
+        origin: str(record.origin),
+        id: raw.id,
+        kind: raw.kind.slice(0, 40),
+        source: raw.source as Source,
+        confidence: typeof raw.confidence === "number" ? raw.confidence : null,
+        filled: raw.filled === true,
+        outcome: "kept" as JevOutcome,
+        field,
+      },
+    ];
+  });
+}
+
+/** One outcome per recorded field, newest fill first; malformed records are ignored. */
+export function outcomes(items: Record<string, unknown>): JevFieldOutcome[] {
+  const fields = new Map<string, JevFieldOutcome>();
+  const edits: { key: string; outcome: JevOutcome }[] = [];
+  for (const key of feedbackKeys(items)) {
+    const record = items[key];
+    if (!isRecord(record) || record.v !== 1 || typeof record.fill !== "string") {
+      continue;
+    }
+    if (record.type === "fill") {
+      for (const item of fillOutcomes(record, record.fill)) {
+        fields.set(`${item.fill}#${item.id}`, item);
+      }
+    } else if (
+      record.type === "edit" &&
+      typeof record.id === "number" &&
+      OUTCOMES.includes(record.outcome)
+    ) {
+      edits.push({ key: `${record.fill}#${record.id}`, outcome: record.outcome as JevOutcome });
+    }
+  }
+  // Edits are applied in write order, so the last change wins: edit then restore counts as kept.
+  for (const edit of edits) {
+    const field = fields.get(edit.key);
+    if (field) {
+      field.outcome = edit.outcome;
+    }
+  }
+  return [...fields.values()].reverse();
+}
+
+export function stats(list: JevFieldOutcome[]): JevFeedbackStats {
+  const result: JevFeedbackStats = {
+    fills: new Set(list.map((o) => o.fill)).size,
+    bySource: {
+      local: { filled: 0, edited: 0, cleared: 0 },
+      jev: { filled: 0, edited: 0, cleared: 0 },
+    },
+    typed: 0,
+  };
+  for (const item of list) {
+    if (!item.filled) {
+      result.typed += item.outcome === "typed" ? 1 : 0;
+    } else if (item.source !== "none") {
+      const bucket = result.bySource[item.source];
+      bucket.filled++;
+      bucket.edited += item.outcome === "edited" ? 1 : 0;
+      bucket.cleared += item.outcome === "cleared" ? 1 : 0;
+    }
+  }
+  return result;
+}
+
+/** A short description of a field for the popup list. */
+export function fieldLabel(item: JevFieldOutcome): string {
+  const f = item.field;
+  const text = f.caption || f.ariaLabel || f.placeholder || f.context || f.name || f.htmlId;
+  return text.slice(0, 40) || `欄 ${item.id + 1}`;
+}
