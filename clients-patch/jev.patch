+  readonly feedbackStore = {
+    all: async (): Promise<Record<string, unknown>> => (await chrome.storage.local.get(null)) ?? {},
+    remove: async (keys: string[]): Promise<void> =>
+      keys.length ? chrome.storage.local.remove(keys) : undefined,
+    set: async (items: Record<string, unknown>): Promise<void> => chrome.storage.local.set(items),
+  };
+  private readonly context = {
+    userId: undefined as UserId | undefined,
+    tab: undefined as chrome.tabs.Tab | undefined,
+    snapshot: undefined as JevPageResult | undefined,
+    values: undefined as SelectedValues | undefined,
+    repromptIds: "",
