+
+/** Injected into the top frame's isolated extension world. Keep this function self-contained. */
+/**
+ * Runs inside the page via chrome.scripting.executeScript, which serializes only this function's
+ * source. It must stay self-contained and must not be `async`: the compiled `__awaiter` helper
+ * lives in the popup bundle and does not exist in the page.
+ */
+export function jevPage(
+  request: JevPageRequest,
+): JevPageResult | null | Promise<JevPageResult | null> {
+  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
+  type Snapshot = {
+    node: Control;
+    signature: string;
+    value: string;
+    field: ReturnType<typeof pageText>;
+  };
+  type State = { token: string; url: string; expires: number; nodes: Snapshot[] };
+  const root = globalThis as typeof globalThis & {
+    __jevBulkFill?: State;
+    __jevFeedback?: () => void;
+  };
+  if (request.action === "fill") {
+    root.__jevFeedback?.();
+  }
+  if (request.action === "clear") {
+    if (request.token === root.__jevBulkFill?.token) {
+      delete root.__jevBulkFill;
+    }
+    return null;
+  }
+  if (location.href !== request.url || location.protocol !== "https:" || self !== self.top) {
+    delete root.__jevBulkFill;
+    return null;
+  }
+  const visible = (node: Control) => {
+    if (!node.isConnected || node.disabled || node.matches(":disabled, [readonly]")) {
+      return false;
+    }
+    if (node.closest("[hidden], [inert], [aria-hidden='true']")) {
+      return false;
+    }
+    let opacity = 1;
+    for (let p: Element | null = node; p; p = p.parentElement) {
+      const style = getComputedStyle(p);
+      opacity *= Number(style.opacity);
+      if (
+        style.display === "none" ||
+        style.visibility !== "visible" ||
+        opacity < 0.1 ||
+        (style.clipPath && style.clipPath !== "none") ||
+        (style.clip && style.clip !== "auto")
