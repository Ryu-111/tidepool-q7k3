+      this.state.feedback.stats = list.length ? stats(list) : null;
+      this.state.feedback.recent = list
+        .filter((o) => o.outcome !== "kept")
+        .slice(0, 10)
+        .map((o: JevFieldOutcome) => ({
+          label: fieldLabel(o),
+          kind: o.kind,
+          source: o.source,
+          outcome: o.outcome,
+        }));
+    } catch {
+      this.state.feedback.stats = null;
+      this.state.feedback.recent = [];
+    }
+    this.changeDetector.markForCheck();
+  }
+
+  async setFeedbackEnabled(enabled: boolean) {
+    this.state.feedback.enabled = enabled;
+    const settings: Record<string, unknown> = { [FEEDBACK_ENABLED_KEY]: enabled };
+    if (!enabled) {
+      const items = await this.feedbackStore.all();
+      settings[FEEDBACK_GENERATION_KEY] = (Number(items[FEEDBACK_GENERATION_KEY]) || 0) + 1;
+    }
+    await this.feedbackStore.set(settings);
+    this.changeDetector.markForCheck();
+  }
+
+  /** Saves every recorded field outcome as JSON, for review or ground-truth labelling. */
+  async exportFeedback() {
+    const list = outcomes(await this.feedbackStore.all());
+    const blob = new Blob([JSON.stringify({ version: 1, outcomes: list }, null, 1)], {
+      type: "application/json",
+    });
+    const link = document.createElement("a");
+    link.href = URL.createObjectURL(blob);
+    link.download = `jev-feedback-${new Date().toISOString().slice(0, 10)}.json`;
+    link.click();
+    URL.revokeObjectURL(link.href);
+  }
+
+  async clearFeedback() {
+    const items = await this.feedbackStore.all();
+    await this.feedbackStore.set({
+      [FEEDBACK_GENERATION_KEY]: (Number(items[FEEDBACK_GENERATION_KEY]) || 0) + 1,
+    });
+    await this.feedbackStore.remove(feedbackKeys(items));
+    await this.loadFeedback();
+  }
+
+  ngOnDestroy() {
+    this.context.destroyed = true;
+    this.invalidate();
+    this.state.apiKey = "";
+    this.destroyed$.next();
+    this.destroyed$.complete();
+  }
+}
