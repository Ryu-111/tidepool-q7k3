+    caption: text(d.caption),
+    ariaLabel: text(d.ariaLabel),
+    placeholder: text(d.placeholder),
+    name: text(d.name),
+    htmlId: text(d.htmlId),
+    context: text(d.context),
+    group: text(d.group),
+    autocomplete: text(d.autocomplete),
