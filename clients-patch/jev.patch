+/** @jest-environment-options {"url":"https://profile.example/form"} */
+// Runs the synthetic pattern pages in probe/fixture/patterns through collection and planning
+// (on-device rules only, no Jev) and compares the planned values with each page's EXPECTED.
+import { readdirSync, readFileSync } from "fs";
+import { join } from "path";
+
+import { JevProfile } from "./jev-format";
+import { planRows } from "./jev-model";
+import { jevPage, JevPageResult } from "./jev-page";
+
+const dir = join(__dirname, "../../../../../../probe/fixture/patterns");
+const pages = readdirSync(dir).filter((f) => f.endsWith(".html"));
+
+const profile: JevProfile = {
+  familyName: "試験",
+  givenName: "太郎",
+  familyKana: "シケン",
+  givenKana: "タロウ",
+  postalCode: "1000001",
+  region: "神奈川県",
+  city: "横浜市中区",
+  municipality: "横浜市",
+  ward: "中区",
+  town: "検証町",
+  chome: "1",
+  ban: "2",
+  go: "3",
+  street: "検証町1-2-3",
+  building: "ダミービル101",
+  phoneParts: ["090", "0000", "0000"],
+  phone: "090-0000-0000",
+  email: "dummy@example.invalid",
+  birthDate: { year: 1990, month: 4, day: 5 },
+  gender: "FEMALE",
+  country: "JP",
+  company: "ダミー株式会社",
+  department: "検証部",
+  jobTitle: "主任",
+};
+
+describe("Jev synthetic pattern pages", () => {
+  beforeEach(() => {
+    jest.spyOn(HTMLElement.prototype, "getClientRects").mockImplementation(function (
+      this: HTMLElement,
+    ) {
+      const top =
+        10 + Array.from(document.querySelectorAll("input,select,textarea")).indexOf(this) * 30;
+      return [
+        { width: 100, height: 20, left: 10, top, right: 110, bottom: top + 20 },
+      ] as unknown as DOMRectList;
+    });
+    jest.spyOn(window, "getComputedStyle").mockReturnValue({
+      display: "block",
+      visibility: "visible",
+      opacity: "1",
+      clipPath: "none",
+      clip: "auto",
+    } as CSSStyleDeclaration);
+    Object.defineProperty(window, "innerHeight", { configurable: true, value: 100000 });
+    Object.defineProperty(document, "elementFromPoint", {
+      configurable: true,
+      value: (_x: number, y: number) =>
+        document.querySelectorAll("input,select,textarea")[Math.floor((y - 10) / 30)],
+    });
+    Object.defineProperty(crypto, "randomUUID", { configurable: true, value: () => "nonce" });
+  });
+  afterEach(() => jest.restoreAllMocks());
+
+  it.each(pages)("%s", async (page) => {
+    const html = readFileSync(join(dir, page), "utf8");
+    const form = html.match(/<form[\s\S]*<\/form>/)![0];
+    document.body.innerHTML = form;
+    // Run the page's inline scripts (they fill some selects and define EXPECTED) in a function
+    // scope, with form controls reachable by name as in a browser.
+    const fixture = document.querySelector<HTMLFormElement>("#fixture")!;
+    const named = new Proxy(fixture, {
+      get: (target, key) =>
+        typeof key === "string" && !(key in target)
+          ? target.elements.namedItem(key)
+          : Reflect.get(target, key, target),
+    });
+    const doc = { querySelector: () => named, title: document.title };
+    const pageWindow: { EXPECTED?: Record<string, string | string[]> } = {};
+    for (const script of html.match(/<script>[\s\S]*?<\/script>/g) ?? []) {
+      new Function("window", "document", script.replace(/<\/?script>/g, ""))(pageWindow, doc);
+    }
+    const expected = pageWindow.EXPECTED!;
+    const snapshot = (await jevPage({ action: "collect", url: location.href })) as JevPageResult;
+    const rows = planRows(snapshot.fields, profile, {}, undefined, {
+      year: 2026,
+      month: 9,
+      day: 29,
+    });
+    const controls = Array.from(
+      document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
+        "#fixture input, #fixture select",
+      ),
+    );
+    const planned: Record<string, string> = {};
+    for (const row of rows) {
+      const name = row.field.name;
+      const node = controls.find((c) => c.name === name)!;
+      const value = row.value ?? "";
+      planned[name] =
+        node instanceof HTMLSelectElement
+          ? (Array.from(node.options).find((o) => o.value === value && value !== "")?.text ?? "")
+          : value;
+    }
+    const wrong = Object.entries(expected).filter(
+      ([name, want]) => name in planned && ![want].flat().includes(planned[name]),
+    );
+    expect(wrong.map(([name, want]) => `${name}: ${planned[name]} != ${want}`)).toEqual([]);
+  });
+});
