+/** Index of the option naming the profile value; -1 when absent. */
+export function optionIndex(
+  options: string[],
+  kind: JevKind,
+  p: JevProfile,
+  today: JevDate,
+): number {
+  const birth = p.birthDate;
+  let exact: string | undefined;
+  let loose: string | undefined;
+  let target = -1;
+  let synonyms: Set<string> | undefined;
+  switch (kind) {
+    case "REGION":
+      if (!p.region) {
+        return -1;
+      }
+      exact = p.region;
+      loose = exact === "北海道" ? exact : exact.replace(/[都府県]$/, "");
+      break;
+    case "CITY":
+      if (!p.city) {
+        return -1;
+      }
+      exact = p.city;
+      loose = p.ward;
+      break;
+    case "MUNICIPALITY":
+      exact = p.municipality;
+      break;
+    case "WARD":
+      exact = p.ward;
+      break;
+    case "BIRTH_YEAR":
+      target = birth?.year ?? -1;
+      break;
+    case "BIRTH_MONTH":
+      target = birth?.month ?? -1;
+      break;
+    case "BIRTH_DAY":
+      target = birth?.day ?? -1;
+      break;
+    case "BIRTH_ERA": {
+      const e = birth && eraName(birth);
+      synonyms = e ? eraSynonyms[e] : undefined;
+      break;
+    }
+    case "BIRTH_ERA_YEAR":
+      target = birth ? Number(eraYear(birth).slice(2)) : -1;
+      break;
+    case "AGE":
+      target = birth ? age(birth, today) : -1;
+      break;
+    case "GENDER":
+      synonyms = p.gender && genderWords[p.gender];
+      break;
+    case "COUNTRY":
+      if (p.country && japan.has(fold(p.country))) {
+        synonyms = japan;
+      } else {
+        exact = p.country;
+      }
+      break;
+    case "JOB_TITLE":
+      exact = p.jobTitle;
+      break;
+    default:
+      return -1;
+  }
+  if (!exact && !synonyms && target < 0) {
+    return -1;
+  }
+  let fallback = -1;
+  for (let i = 0; i < options.length; i++) {
+    const option = fold(options[i] ?? "");
+    if (synonyms?.has(option) || (exact && option === fold(exact))) {
+      return i;
+    }
+    if (loose && option === fold(loose) && fallback < 0) {
+      fallback = i;
+    }
+    if (target >= 0 && optionNumber(option, kind === "BIRTH_YEAR") === target) {
+      return i;
+    }
+  }
+  return fallback;
+}
