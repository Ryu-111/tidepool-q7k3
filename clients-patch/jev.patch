@@ -0,0 +1,149 @@
+<main class="tw-p-4 tw-text-main">
+  <a routerLink="/tabs/vault">← 保管庫へ戻る</a>
+  <h1 class="tw-text-xl tw-font-semibold tw-my-3">Jev 一括入力</h1>
+  <p class="tw-break-all">入力先：{{ state.origin || "HTTPSページを開いてください" }}</p>
+  <p class="tw-my-2">
+    このページの空欄に、選んだプロフィールを一括入力します。入力済みの欄は変更せず、フォームの送信もしません。
+  </p>
+  <fieldset [disabled]="state.busy" class="tw-flex tw-flex-col tw-gap-3 tw-my-3">
+    <label
+      >プロフィール
+      <select
+        [(ngModel)]="state.identityId"
+        (ngModelChange)="invalidate(); quickFill()"
+        class="tw-w-full tw-text-main tw-bg-background"
+      >
+        <option value="">使わない</option>
+        @for (item of state.identities; track item.id) {
+          <option [value]="item.id">{{ item.name }}</option>
+        }
+      </select>
+    </label>
+    <label
+      >このサイトのログイン情報（選ぶとパスワードも入力）
+      <select
+        [(ngModel)]="state.loginId"
+        (ngModelChange)="invalidate()"
+        class="tw-w-full tw-text-main tw-bg-background"
+      >
+        <option value="">使わない</option>
+        @for (item of state.logins; track item.id) {
+          <option [value]="item.id">{{ item.name }}</option>
+        }
+      </select>
+    </label>
+    <button
+      type="button"
+      (click)="quickFill()"
+      [disabled]="!state.identityId && !state.loginId"
+      class="tw-border tw-rounded tw-p-2"
+    >
+      このページに入力
+    </button>
+  </fieldset>
+  @if (state.filled.length) {
+    <p class="tw-font-semibold">入力した欄</p>
+    <ul class="tw-list-disc tw-ml-5 tw-mb-2">
+      @for (item of state.filled; track $index) {
+        <li>{{ item }}</li>
+      }
+    </ul>
+  }
+  @if (state.skipped.length) {
+    <p class="tw-font-semibold">入力しなかった欄</p>
+    <ul class="tw-list-disc tw-ml-5 tw-mb-2">
+      @for (item of state.skipped; track $index) {
+        <li>{{ item }}</li>
+      }
+    </ul>
+  }
+  @if (state.jevNote) {
+    <p class="tw-my-2">{{ state.jevNote }}</p>
+  }
+  <details class="tw-my-3">
+    <summary>
+      入力後の修正の記録（{{
+        state.feedback.enabled ? (state.feedback.stats?.fills ?? 0) + "回分" : "停止中"
+      }}）
+    </summary>
+    <p class="tw-text-sm tw-my-2">
+      一括入力のあとに書き直した・消した・自分で埋めた欄を、判定の誤りとして記録します。記録するのは欄名などページ上の文字と判定した種類だけで、入力した値やページのパスは残しません。パスワード欄は対象外です。保存先はこの拡張の中だけです。
+    </p>
+    <label class="tw-flex tw-gap-2 tw-items-center">
+      <input
+        type="checkbox"
+        [ngModel]="state.feedback.enabled"
+        (ngModelChange)="setFeedbackEnabled($event)"
+      />
+      修正を記録する
+    </label>
+    @if (state.feedback.stats; as s) {
+      <ul class="tw-list-disc tw-ml-5 tw-my-2 tw-text-sm">
+        <li>
+          端末ルールで入力 {{ s.bySource.local.filled }}欄 → 書き直し
+          {{ s.bySource.local.edited }}・消去
+          {{ s.bySource.local.cleared }}
+        </li>
+        <li>
+          Jevで入力 {{ s.bySource.jev.filled }}欄 → 書き直し {{ s.bySource.jev.edited }}・消去
+          {{ s.bySource.jev.cleared }}
+        </li>
+        <li>空欄のまま残し、自分で入力 {{ s.typed }}欄</li>
+      </ul>
+    }
+    @if (state.feedback.recent.length) {
+      <p class="tw-text-sm tw-font-semibold">最近の修正</p>
+      <ul class="tw-list-disc tw-ml-5 tw-mb-2 tw-text-sm">
+        @for (item of state.feedback.recent; track $index) {
+          <li>
+            {{ item.label }}：{{ item.kind }}（{{ item.source === "jev" ? "Jev" : "端末" }}）→
+            {{
+              item.outcome === "edited"
+                ? "書き直し"
+                : item.outcome === "cleared"
+                  ? "消去"
+                  : "自分で入力"
+            }}
+          </li>
+        }
+      </ul>
+    }
+    <div class="tw-flex tw-gap-2 tw-mt-2">
+      <button type="button" (click)="exportFeedback()" class="tw-border tw-rounded tw-p-2">
+        書き出す（JSON）
+      </button>
+      <button type="button" (click)="clearFeedback()" class="tw-border tw-rounded tw-p-2">
+        記録を消す
+      </button>
+    </div>
+  </details>
+  <details class="tw-my-3">
+    <summary>Jev の設定（{{ state.keySaved ? "キー保存済み" : "キー未設定" }}）</summary>
+    <p class="tw-text-sm tw-my-2">
+      端末内のルールで判定できない欄だけ、ページ上の欄名・記入例などを Jev
+      に送って判定します。あなたの氏名・住所などの値、ページのURL、パスワード欄は送りません。
+    </p>
+    <label
+      >OpenRouter APIキー（この拡張の中だけに保存）
+      <input
+        type="password"
+        [(ngModel)]="state.apiKey"
+        autocomplete="off"
+        spellcheck="false"
+        class="tw-w-full tw-bg-background tw-text-main tw-border"
+      />
+    </label>
+    <div class="tw-flex tw-gap-2 tw-mt-2">
+      <button type="button" (click)="saveKey()" class="tw-border tw-rounded tw-p-2">保存</button>
+      @if (state.keySaved) {
+        <button type="button" (click)="clearKey()" class="tw-border tw-rounded tw-p-2">削除</button>
+      }
+    </div>
+  </details>
+  <p role="status" aria-live="polite" class="tw-my-3">
+    {{ state.busy ? "処理中…" : state.message }}
+  </p>
+  <p class="tw-text-sm">
+    別サイトの埋め込み欄、ラジオボタン、独自部品にはまだ対応していません。住所の自動補完があるサイトでは、入力後の内容も確認してください。
+  </p>
+</main>
