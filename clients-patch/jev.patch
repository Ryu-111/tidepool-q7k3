+      stats: null as JevFeedbackStats | null,
+      recent: [] as { label: string; kind: string; source: string; outcome: string }[],
+    },
+  };
+  /** Fill as soon as the screen opens when the profile to use is known. */
+  readonly options = { autoFillOnOpen: true };
+  /** Where the Jev key is kept; replaceable in tests. */
+  readonly keyStore = {
