+add("BIRTH_YEAR", "birthdate_y");
+add("BIRTH_MONTH", "birthdate_m");
+add("BIRTH_DAY", "birthdate_d");
+add("BIRTH_ERA", "元号", "年号", "和暦", "era", "birth_era", "gengo");
+add("GENDER", "性別", "gender", "sex", "seibetsu");
+add("AGE", "年齢", "age", "ご年齢");
+add("COUNTRY", "国", "国名", "国・地域", "country", "country-name", "国籍");
+add("COMPANY", "会社名", "勤務先", "勤務先名", "法人名", "企業名", "団体名", "組織名");
+add("COMPANY", "company", "company name", "company_name", "organization");
+add("DEPARTMENT", "部署", "部署名", "所属", "所属部署", "department", "dept");
+add("JOB_TITLE", "役職", "役職名", "職位", "job title", "job_title", "jobtitle");
+[
+  "必須",
+  "任意",
+  "半角",
+  "全角",
+  "半角数字",
+  "全角数字",
+  "半角英数",
+  "半角英数字",
+  "全角カナ",
+  "全角カタカナ",
+  "半角カナ",
+  "半角カタカナ",
+  "ひらがな",
+  "カタカナ",
+  "ハイフンなし",
+  "ハイフン無し",
+  "ハイフン不要",
+  "ハイフンあり",
+  "ハイフン有り",
+  "ハイフン必須",
+  "数字のみ",
+  "required",
+  "optional",
+  "確認用",
+  "西暦",
+  "和暦",
+  "数字",
+  "スラッシュなし",
+  "スラッシュ区切り",
+  "yyyy/mm/dd",
+  "yyyymmdd",
+  "漢字",
+  "カレンダー",
+  "カレンダー入力",
+  "カレンダーから選択",
+  "選択",
+].forEach((n) => notes.add(normalize(n)));
+
+const bracket = /[([【「]([^)\]】」]*)[)\]】」]/g;
+const lengthNote = /^(半角|全角)?(数字|英数字)?[0-9]{1,2}(桁|文字)(以内)?$/;
+
+/**
+ * Maps page text (a label, name, id, placeholder or autocomplete token) to a kind through a
+ * fixed vocabulary. Unknown text, including anything that looks like an instruction, is UNKNOWN.
+ */
+export function labelKind(raw: string | null | undefined): JevKind {
+  if (!raw || raw.length > 128) {
+    return "UNKNOWN";
+  }
+  let text = normalize(raw);
+  const direct = labels.get(text);
+  if (direct) {
+    return direct;
+  }
+  // Drop only known annotations: "(必須)", "【半角数字】", "※...", "例)...", "*", leading ご/お.
+  text = text
+    .replace(/^[*※\s]+/u, "")
+    .replace(/[※*].*$/u, "")
+    .replace(/\s*例[:)].*$/u, "");
+  let kept = "";
+  let last = 0;
+  for (const match of text.matchAll(bracket)) {
+    const note = match[1].trim();
+    const known =
+      note.startsWith("例") ||
+      note.split(/[・、,\s]+/u).some((part) => notes.has(part) || lengthNote.test(part));
+    if (!known) {
+      continue; // meaningful brackets such as 姓(フリガナ) stay in the label
+    }
+    kept += text.slice(last, match.index);
+    last = match.index! + match[0].length;
+  }
+  kept += text.slice(last);
+  text = kept
+    .replace(/(?:必須|任意)\s*$/u, "")
+    .replace(/を入力(?:して(?:ください|下さい))?[。.]?$/u, "")
+    .replace(/[:：]\s*.*$/u, "")
+    .replace(/^お住まいの/u, "")
+    .trim();
+  const trimmed = labels.get(text);
+  if (trimmed) {
+    return trimmed;
+  }
+  if (text.startsWith("ご") || text.startsWith("お")) {
+    return labels.get(text.slice(1)) ?? "UNKNOWN";
+  }
+  return "UNKNOWN";
+}
+
+/** The closest heading, not a keyword search through earlier rows. */
+export function rowHeading(raw: string): { text: string; kind: JevKind; separator: boolean } {
+  const text = normalize(raw);
+  const separator = /(?:^|\s)[ー\-年月日]+\s*$/u.test(text);
+  const tokens = text
+    .replace(bracket, (whole, note: string) =>
+      note.startsWith("例") || notes.has(note) || lengthNote.test(note) ? " " : whole,
+    )
+    .split(/\s+/u)
+    .filter(
+      (token) =>
+        token &&
+        !/^(?:[※*:〒ー\-年月日]+|いずれか必須)$/u.test(token) &&
+        !token.startsWith("※") &&
+        !token.startsWith("例") &&
+        !notes.has(token) &&
+        !lengthNote.test(token) &&
+        !/^(?:半角|全角)/u.test(token),
+    );
+  const heading = tokens.at(-1) ?? "";
+  return { text: heading, kind: labelKind(heading), separator };
+}
+
+/** Parse identifier tokens, never arbitrary substrings of prose or a site-specific prefix. */
+export function identifierKind(raw: string): JevKind {
+  if (!raw || raw.length > 128) {
+    return "UNKNOWN";
+  }
+  let tokens = raw
+    .normalize("NFKC")
+    .replace(/([a-z])([A-Z])/g, "$1_$2")
+    .toLowerCase()
+    .split(/[_\s.[\]$:-]+/u)
+    .filter(Boolean);
+  const text = tokens.join("_");
+  if (tokens.some((t) => /^(?:fax|spouse|guardian|parent|emergency|destination)$/u.test(t))) {
+    return "UNKNOWN";
+  }
+  // A numeric suffix can be a box number or a separate field. Resolve it from siblings.
+  if (/(?:^|_)(?:name|addr|address|tel|phone)(?:_?0?[1-3])(?:input)?$/u.test(text)) {
+    return "UNKNOWN";
+  }
+  const reading = tokens.some((t) => /^(?:kana|furigana|phonetic)$/u.test(t));
+  if (reading && tokens.length > 1) {
+    tokens = tokens.filter((t) => !/^(?:kana|furigana|phonetic)$/u.test(t));
+  }
+  while (
+    tokens.length > 1 &&
+    /^(?:confirm|confirmation|check|cf|input|sai|nyuryoku)$/u.test(tokens.at(-1)!)
+  ) {
+    tokens.pop();
+  }
+  for (let start = 0; start < tokens.length; start++) {
+    const part = tokens.slice(start).join("_");
+    let kind = labelKind(part);
+    if (/^(?:email|mail)_?\d+$/u.test(part)) {
+      kind = "EMAIL";
+    }
+    if (reading) {
+      if (kind === "FAMILY") {
+        kind = "FAMILY_KANA";
+      } else if (kind === "GIVEN") {
+        kind = "GIVEN_KANA";
+      } else if (kind === "FULL_NAME") {
+        kind = "FULL_KANA";
+      } else if (kind === "COMPANY") {
+        return "UNKNOWN"; // Organization readings are not a personal name.
+      }
+    }
+    if (kind !== "UNKNOWN") {
+      return kind;
+    }
+  }
+  return "UNKNOWN";
+}
+
+/**
+ * Resolves form structure after classification, from kinds and document order only.
+ * 1. A run of adjacent identical kinds with as many fields as components is a split field
+ *    (郵便番号 3+4, 電話 3 parts, 姓/名 under one label), assigned in component order.
+ * 2. A combined field drops components that another field on the form fills by itself
+ *    (住所 next to 都道府県 becomes ADDRESS_AFTER_REGION).
+ */
+export function refine(shapes: JevShape[], chosen: JevKind[]): JevKind[] {
+  const kinds = [...chosen];
+  for (let start = 0; start < kinds.length;) {
+    let end = start + 1;
+    while (end < kinds.length && kinds[end] === kinds[start]) {
+      end++;
+    }
+    const run = end - start;
+    if (kinds[start] === "BIRTHDATE" && run === 3) {
+      (["BIRTH_YEAR", "BIRTH_MONTH", "BIRTH_DAY"] as JevKind[]).forEach(
+        (kind, i) => (kinds[start + i] = kind),
+      );
+    } else if (kinds[start] !== "UNKNOWN" && run > 1 && run === bitCount(maskOf(kinds[start]))) {
+      let remaining = maskOf(kinds[start]);
+      for (let i = start; i < end; i++) {
+        const lowest = remaining & -remaining;
+        remaining &= ~lowest;
+        kinds[i] = kindOf(lowest);
+      }
+    }
+    start = end;
+  }
+  // With a separate 元号 field, the year field takes the year within that era.
+  if (kinds.includes("BIRTH_ERA")) {
+    kinds.forEach((k, i) => {
+      if (k === "BIRTH_YEAR") {
+        kinds[i] = "BIRTH_ERA_YEAR";
+      }
+    });
+  }
+  return kinds.map((kind, i) => {
+    let mask = maskOf(kind);
+    if (isAddress(kind)) {
+      // Unrelated fields separate address sections; never borrow parts from another section.
+      let start = i;
+      let end = i + 1;
+      while (start > 0 && isAddress(kinds[start - 1])) {
+        start--;
+      }
+      while (end < kinds.length && isAddress(kinds[end])) {
+        end++;
+      }
+      for (let j = start; j < end; j++) {
+        if (j !== i && kinds[j] !== kind && isWithin(kinds[j], kind)) {
+          mask &= ~maskOf(kinds[j]);
+        }
+      }
+    }
+    const refined = mask === maskOf(kind) ? kind : kindOf(mask);
+    return isCompatible(shapes[i], refined) ? refined : "UNKNOWN";
+  });
+}
