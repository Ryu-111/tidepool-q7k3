+      .map((label) => label.textContent ?? "")
+      .join(" ")
+      .slice(0, 256),
+    ariaLabel: (node.getAttribute("aria-label") ?? "").slice(0, 256),
+    placeholder: (node.getAttribute("placeholder") ?? "").slice(0, 256),
+    name: (node.getAttribute("name") ?? "").slice(0, 256),
+    htmlId: node.id.slice(0, 256),
+    context: precedingText(node),
