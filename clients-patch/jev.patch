+
+export interface JevPageResult {
+  token: string;
+  url: string;
+  fields: JevPageField[];
+  written: number;
+  changed: number;
+}
+
+/** What the popup decided for one collected field, for recording later corrections. */
+export interface JevFeedbackRow {
+  id: number;
+  kind: string;
+  source: "local" | "jev" | "none";
+  /** Jev's confidence, or null when the kind did not come from Jev. */
+  confidence: number | null;
+}
+
+export interface JevPageRequest {
+  action: "collect" | "fill" | "clear";
+  url: string;
+  token?: string;
+  entries?: { id: number; value: string; overwrite: boolean }[];
+  /** When present, the user's later edits of these fields are recorded (never their values). */
+  feedback?: JevFeedbackRow[];
