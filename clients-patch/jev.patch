+function birthdate(b: JevDate, f: JevFormat, shape: JevShape, full: boolean): string | null {
+  if (shape === "DATE") {
+    return `${b.year}-${pad(b.month, true)}-${pad(b.day, true)}`;
+  }
+  const kanjiDate = f.dateKanji || f.era;
+  const padded = kanjiDate ? f.datePad === true : f.datePad !== false;
+  const year = f.era ? eraYear(b) : String(b.year);
+  const sep = f.dateSeparator ?? "/";
+  let value = kanjiDate
+    ? `${year}年${pad(b.month, padded)}月${pad(b.day, padded)}日`
+    : `${year}${sep}${pad(b.month, padded)}${sep}${pad(b.day, padded)}`;
+  value = width(value, f, full);
+  return (
+    fits(value, f) ??
+    (f.dateSeparator === null && !kanjiDate
+      ? fits(year + pad(b.month, true) + pad(b.day, true), f)
+      : null)
+  );
