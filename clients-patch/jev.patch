+// Value rendering for the Jev bulk fill, ported from the Android JevFormat / JevFormatter /
+// JevProfileMapper. Page text read here never leaves the extension.
+import type { CipherView } from "@bitwarden/common/vault/models/view/cipher.view";
+
+import {
+  ADDR_BAN,
+  ADDR_BUILDING,
+  ADDR_CHOME,
+  ADDR_GO,
+  ADDR_MUNICIPALITY,
+  ADDR_REGION,
+  ADDR_TOWN,
+  ADDR_WARD,
+  JevKind,
+  JevShape,
+  maskOf,
+} from "./jev-kinds";
+
+export type JevGender = "FEMALE" | "MALE" | "OTHER";
+export interface JevDate {
+  year: number;
+  month: number;
+  day: number;
+}
+
+/** Values from one Identity; an absent component was never registered and is never guessed. */
+export interface JevProfile {
+  familyName?: string;
+  givenName?: string;
+  familyKana?: string;
+  givenKana?: string;
+  /** Digits only, e.g. "1000001". */
+  postalCode?: string;
+  region?: string;
+  city?: string;
+  municipality?: string;
+  ward?: string;
+  town?: string;
+  chome?: string;
+  ban?: string;
+  go?: string;
+  /** Identity address1 (町名＋番地), used when the parts are absent. */
+  street?: string;
+  building?: string;
+  /** Only when the stored phone has hyphens. */
+  phoneParts?: string[];
+  phone?: string;
+  email?: string;
+  birthDate?: JevDate;
+  gender?: JevGender;
+  country?: string;
+  company?: string;
+  department?: string;
+  jobTitle?: string;
+  username?: string;
+}
+
+const clean = (v: string | null | undefined) => {
+  const t = v?.trim();
+  return t ? t : undefined;
+};
+
+/** The profile of an unlocked Identity item, with its jev.* custom text fields. */
+export function toJevProfile(cipher: CipherView): JevProfile | null {
+  const p = cipher.identity;
+  if (!p) {
+    return null;
+  }
+  const custom = new Map<string, string | undefined>();
+  for (const field of cipher.fields ?? []) {
+    const name = field.name?.trim();
+    const value = clean(field.value);
+    if ((field.type === 0 || field.type === 1) && name && value) {
+      // Duplicate keys are ambiguous: leave them unfilled.
+      custom.set(name, custom.has(name) ? undefined : value);
+    }
+  }
+  const c = (key: string) => custom.get(`jev.${key}`);
+  const phone = clean(p.phone);
+  const parts = phone?.match(/^([0-9]{2,5})-([0-9]{1,4})-([0-9]{3,4})$/);
+  const birth = c("birthdate")?.match(/^(\d{4})-(\d{2})-(\d{2})$/);
+  let birthDate: JevDate | undefined;
+  if (birth) {
+    const [year, month, day] = birth.slice(1).map(Number);
+    const d = new Date(Date.UTC(year, month - 1, day));
+    if (d.getUTCFullYear() === year && d.getUTCMonth() === month - 1 && d.getUTCDate() === day) {
+      birthDate = { year, month, day };
+    }
+  }
+  const gender = ({ female: "FEMALE", male: "MALE", other: "OTHER" } as const)[
+    (c("gender")?.toLowerCase() ?? "") as "female"
+  ];
+  const postal = p.postalCode?.replace(/\D/g, "");
+  return {
+    familyName: clean(p.lastName),
+    givenName: clean(p.firstName),
+    familyKana: c("family_kana"),
+    givenKana: c("given_kana"),
+    postalCode: postal ? postal : undefined,
+    region: clean(p.state),
+    city: clean(p.city),
+    municipality: c("municipality"),
+    ward: c("ward"),
+    town: c("town"),
+    chome: c("chome"),
+    ban: c("ban"),
+    go: c("go"),
+    street: clean(p.address1),
+    building: [clean(p.address2), clean(p.address3)].filter(Boolean).join(" ") || undefined,
+    phoneParts: parts ? parts.slice(1) : undefined,
+    phone,
+    email: clean(p.email),
+    birthDate,
+    gender,
+    country: clean(p.country),
+    company: clean(p.company),
+    department: c("department"),
+    jobTitle: c("job_title"),
+    username: clean(p.username),
+  };
+}
+
+/** How a field wants its value written; null properties mean "no evidence". */
+export interface JevFormat {
+  hyphen: boolean | null;
+  /** Width of ASCII letters, digits and punctuation. */
+  fullWidth: boolean | null;
+  /** Kana width is independent of ASCII width; generic 半角 does not narrow kana. */
+  kanaWidth: boolean | null;
+  hiragana: boolean;
+  nameSeparator: string | null;
+  dateSeparator: string | null;
+  datePad: boolean | null;
+  dateKanji: boolean;
+  era: boolean;
+  blockKanji: boolean;
+  maxLength: number;
+}
+
+const digitsHyphen = /^[0-9]{2,5}-[0-9]{2,4}(-[0-9]{3,4})?$/;
+const digitsOnly = /^[0-9]{7,11}$/;
+const hiraganaText = /^[ぁ-ゟー\s\u3000]+$/u;
+const nameExample = /^[^\s\u3000]+([\s\u3000])[^\s\u3000]+$/u;
+const dateSeparated = /^([0-9]{4}|yyyy)([/.-])([0-9]{1,2}|mm?)\2([0-9]{1,2}|dd?)$/i;
+const dateCompact = /^([0-9]{8}|yyyymmdd)$/i;
+const dateKanjiExample = /([0-9]+|y+)年([0-9]+|m+)月([0-9]+|d+)日/i;
+const paddedPart = /^(0[0-9]|mm|dd)$/i;
+const noHyphen = /ハイフン(?:は|が)?(なし|無し|不要|を除く|を入れない)/;
+const withHyphen = /ハイフン(あり|有り|必須|を含|を入れ)/;
+const eraWords = /(和暦|昭和|平成|令和)/;
+const examplePrefix = /^(例|例え?ば)?[:：)）]?\s*/u;
+
+/** Reads constraints in priority order (nearest text first). */
+export function parseFormat(texts: string[], maxLength: number): JevFormat {
+  let f: JevFormat = {
+    hyphen: null,
+    fullWidth: null,
+    kanaWidth: null,
+    hiragana: false,
+    nameSeparator: null,
+    dateSeparator: null,
+    datePad: null,
+    dateKanji: false,
+    era: false,
+    blockKanji: false,
+    maxLength: maxLength > 0 ? maxLength : -1,
+  };
+  for (const raw of texts
+    .filter(Boolean)
+    .map((t) => t.slice(0, 256))
+    .reverse()) {
+    const text = raw.trim();
+    const folded = text.normalize("NFKC");
+    for (const note of folded.matchAll(
+      /(全角|半角)\s*(カタカナ|ひらがな|カナ|かな|漢字|英数字|英数|英字|数字)?/gu,
+    )) {
+      const full = note[1] === "全角";
+      if (!note[2] || /英|数字/u.test(note[2])) {
+        f.fullWidth = full;
+      }
+      if (/カタカナ|ひらがな|カナ|かな|漢字/u.test(note[2] ?? "") || (!note[2] && full)) {
+        f.kanaWidth = full;
+      }
+    }
+    const kanaNote = folded.match(
+      /半角\s*(?:カタカナ|カナ)|カタカナ|フリガナ|カナ|ひらがな|ふりがな|かな/u,
+    );
+    if (kanaNote) {
+      f.hiragana = /ひらがな|ふりがな|かな/u.test(kanaNote[0]);
+      f.kanaWidth = !kanaNote[0].startsWith("半角");
+    }
+    f = {
+      ...f,
+      hyphen: noHyphen.test(folded) ? false : withHyphen.test(folded) ? true : f.hyphen,
+      era: f.era || eraWords.test(folded),
+      blockKanji: f.blockKanji || (folded.includes("丁目") && folded.includes("番")),
+    };
+    const example = text.replace(examplePrefix, "").trim();
+    const ex = example.normalize("NFKC").replace(/ー/g, "-").replace(/−/g, "-");
+    const widened = example !== ex ? true : null;
+    const separated = ex.match(dateSeparated);
+    const kanji = ex.match(dateKanjiExample);
+    if (separated) {
+      f = { ...f, dateSeparator: separated[2], datePad: separated[3].length === 2 };
+    } else if (kanji) {
+      f = { ...f, dateKanji: true, datePad: kanji[2].length === 2 };
+    } else if (dateCompact.test(ex)) {
+      f = {
+        ...f,
+        dateSeparator: "",
+        datePad: true,
+        hyphen: f.hyphen ?? false,
+        fullWidth: f.fullWidth ?? widened,
+      };
+    } else if (paddedPart.test(ex)) {
+      f = { ...f, datePad: true };
+    } else if (digitsHyphen.test(ex)) {
+      f = { ...f, hyphen: f.hyphen ?? true, fullWidth: f.fullWidth ?? widened };
+    } else if (digitsOnly.test(ex)) {
+      f = { ...f, hyphen: f.hyphen ?? false, fullWidth: f.fullWidth ?? widened };
+    } else if (example && example.length <= 16) {
+      f = {
+        ...f,
+        nameSeparator: f.nameSeparator ?? example.match(nameExample)?.[1] ?? null,
+        hiragana: kanaNote
+          ? f.hiragana
+          : (hiraganaText.test(example) && example.length > 1) || f.hiragana,
+      };
+    }
+  }
+  return f;
+}
+
+const eraNames = ["令和", "平成", "昭和", "大正", "明治"];
+const eraStarts: JevDate[] = [
+  { year: 2019, month: 5, day: 1 },
+  { year: 1989, month: 1, day: 8 },
+  { year: 1926, month: 12, day: 25 },
+  { year: 1912, month: 7, day: 30 },
+  { year: 1868, month: 1, day: 25 },
+];
+const dateKey = (d: JevDate) => d.year * 10000 + d.month * 100 + d.day;
+
+/** "平成2" for 1990-04-05; the western year before 明治. */
+export function eraYear(date: JevDate): string {
+  for (let i = 0; i < eraNames.length; i++) {
+    if (dateKey(date) >= dateKey(eraStarts[i])) {
+      return eraNames[i] + (date.year - eraStarts[i].year + 1);
+    }
+  }
+  return String(date.year);
+}
+const eraName = (d: JevDate) => {
+  const e = eraYear(d);
+  return /^\d+$/.test(e) ? null : e.slice(0, 2);
+};
+const age = (b: JevDate, today: JevDate) =>
+  today.year - b.year - (today.month * 100 + today.day < b.month * 100 + b.day ? 1 : 0);
+const pad = (v: number, p: boolean) => (p && v < 10 ? `0${v}` : String(v));
+
+/** ASCII to full-width, space to ideographic space. */
+export const toFullWidth = (v: string) =>
+  v.replace(/[!-~ ]/g, (c) =>
+    c === " " ? "\u3000" : String.fromCharCode(c.charCodeAt(0) + 0xfee0),
+  );
+
+const halfKana = (() => {
+  const map = new Map<string, string>();
+  for (let code = 0xff66; code <= 0xff9d; code++) {
+    const half = String.fromCharCode(code);
+    map.set(half.normalize("NFKC"), half);
+    for (const mark of ["ﾞ", "ﾟ"]) {
+      const full = (half + mark).normalize("NFKC");
+      if (full.length === 1) {
+        map.set(full, half + mark);
+      }
+    }
+  }
+  map.set("\u3000", " ");
+  return map;
+})();
+/** Full-width katakana to half-width, e.g. ダミー to ﾀﾞﾐｰ. */
+export const toHalfWidthKana = (v: string) => [...v].map((c) => halfKana.get(c) ?? c).join("");
+
+const fullKana = (v: string) => v.replace(/[｡-ﾟ]+/gu, (s) => s.normalize("NFKC"));
+export const toHalfWidthAscii = (v: string) =>
+  v.replace(/[！-～\u3000]/gu, (c) =>
+    c === "\u3000" ? " " : String.fromCharCode(c.charCodeAt(0) - 0xfee0),
+  );
+const toKatakana = (v: string) =>
+  fullKana(v).replace(/[ぁ-ゖ]/gu, (c) => String.fromCharCode(c.charCodeAt(0) + 0x60));
+const toHiragana = (v: string) =>
+  fullKana(v).replace(/[ァ-ヶ]/gu, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));
+const kana = (value: string, f: JevFormat) =>
+  f.hiragana
+    ? toHiragana(value)
+    : f.kanaWidth === false
+      ? toHalfWidthKana(toKatakana(value))
+      : toKatakana(value);
+const width = (value: string, f: JevFormat, full: boolean) => {
+  if (f.kanaWidth === true) {
+    value = fullKana(value);
+  } else if (f.kanaWidth === false) {
+    value = toHalfWidthKana(value);
+  }
+  return full ? toFullWidth(value) : f.fullWidth === false ? toHalfWidthAscii(value) : value;
+};
+
+/** Apply local input hints, then choose the first complete pattern match. */
+export function constrainedValue(
+  value: string | null,
+  pattern: string | undefined,
+  inputmode: string | undefined,
+  maxLength: number,
+  alternatives: (string | null)[] = [],
+): string | null {
+  if (value === null) {
+    return null;
+  }
+  if (/^(numeric|tel|email)$/iu.test(inputmode ?? "")) {
+    value = toHalfWidthAscii(value);
+  }
+  if (!pattern) {
+    return value;
+  }
+  let regex: RegExp;
+  try {
+    regex = new RegExp("^(?:" + pattern + ")$", "v");
+  } catch {
+    try {
+      regex = new RegExp("^(?:" + pattern + ")$", "u");
+    } catch {
+      return value;
+    }
+  }
+  const variants = new Set<string>([value]);
+  for (const base of [value, ...alternatives]) {
+    if (base === null) {
+      continue;
+    }
+    for (const ascii of [base, toHalfWidthAscii(base), toFullWidth(base)]) {
+      for (const reading of [
+        ascii,
+        toHiragana(ascii),
+        toKatakana(ascii),
+        toHalfWidthKana(toKatakana(ascii)),
+      ]) {
+        variants.add(reading);
+        variants.add(reading.replace(/[-－]/gu, ""));
+      }
+    }
+  }
+  for (const variant of variants) {
+    if (
+      (maxLength <= 0 || [...variant].length <= maxLength) &&
+      regex.exec(variant)?.[0] === variant
+    ) {
+      return variant;
+    }
+  }
+  return value;
+}
+
+const fits = (v: string, f: JevFormat) =>
+  f.maxLength > 0 && [...v].length > f.maxLength ? null : v;
+
+function name(family: string | undefined, given: string | undefined, f: JevFormat, full: boolean) {
+  if (!family || !given) {
+    return null;
+  }
+  return family + (f.nameSeparator ?? (full ? "\u3000" : " ")) + given;
+}
+
+function postalParts(p: JevProfile): [string, string] | null {
+  const d = p.postalCode?.replace(/\D/g, "");
+  return d && d.length === 7 ? [d.slice(0, 3), d.slice(3)] : null;
+}
+
+function address(mask: number, p: JevProfile, blockKanji: boolean, full: boolean): string | null {
+  let out = "";
+  if (mask & ADDR_REGION) {
+    if (!p.region) {
+      return null;
+    }
+    out += p.region;
+  }
+  const m = (mask & ADDR_MUNICIPALITY) !== 0;
+  const w = (mask & ADDR_WARD) !== 0;
+  if (m && w) {
+    const city = p.city ?? (p.municipality && p.ward ? p.municipality + p.ward : undefined);
+    if (!city) {
+      return null;
+    }
+    out += city;
+  } else if (m || w) {
+    const part = m ? p.municipality : p.ward;
+    if (!part) {
+      return null;
+    }
+    out += part;
+  }
+  const t = (mask & ADDR_TOWN) !== 0;
+  const bits = [ADDR_CHOME, ADDR_BAN, ADDR_GO];
+  const parts = [p.chome, p.ban, p.go];
+  const selected = bits.map((b, i) => ((mask & b) !== 0 ? i : -1)).filter((i) => i >= 0);
+  const partsMissing = !p.town || parts.some((x) => !x);
+  if (t && selected.length === 3 && partsMissing) {
+    // Only the stored street line (町名＋番地) is available; use it as registered.
+    if (!p.street) {
+      return null;
+    }
+    out += p.street;
+  } else {
+    if (t) {
+      if (!p.town) {
+        return null;
+      }
+      out += p.town;
+    }
+    if (selected.length) {
+      const values = selected.map((i) => parts[i]);
+      if (values.some((v) => !v)) {
+        return null;
+      }
+      const suffixes = ["丁目", "番", "号"];
+      const single = values.length === 1 && out === "";
+      const chomeOnly = values.length === 1 && (mask & ADDR_CHOME) !== 0;
+      out += single
+        ? values[0]
+        : blockKanji || chomeOnly
+          ? selected.map((i, n) => values[n] + suffixes[i]).join("")
+          : values.join("-");
+    }
+  }
+  if (mask & ADDR_BUILDING) {
+    if (!p.building) {
+      return null;
+    }
+    if (out) {
+      out += full ? "\u3000" : " ";
+    }
+    out += p.building;
+  }
+  return out || null;
+}
+
+const genderText = { FEMALE: "女性", MALE: "男性", OTHER: "その他" } as const;
+const fold = (v: string) => v.normalize("NFKC").replace(/\s/g, "").toLowerCase();
+const words = (...v: string[]) => new Set(v.map(fold));
+const genderWords = {
+  FEMALE: words("女性", "女", "female", "f", "woman", "women"),
+  MALE: words("男性", "男", "male", "m", "man", "men"),
+  OTHER: words("その他", "other", "非回答", "回答しない"),
+};
+const eraSynonyms: Record<string, Set<string>> = {
+  令和: words("令和", "r", "reiwa"),
+  平成: words("平成", "h", "heisei"),
+  昭和: words("昭和", "s", "showa"),
+  大正: words("大正", "t", "taisho"),
+  明治: words("明治", "m", "meiji"),
+};
+const japan = words("日本", "日本国", "japan", "jp", "jpn");
+
+/** Text for a classified text field, or null when it is not registered or does not fit. */
+export function render(
+  kind: JevKind,
+  format: JevFormat,
+  shape: JevShape,
+  p: JevProfile,
+  today: JevDate,
+): string | null {
+  const numeric = shape === "NUMBER";
+  const full = !numeric && format.fullWidth === true;
+  const birth = p.birthDate;
+  const digits = (parts: string[]) => parts.join(!numeric && format.hyphen === true ? "-" : "");
+  let value: string | null | undefined;
+  switch (kind) {
+    case "FAMILY":
+      value = p.familyName;
+      break;
+    case "GIVEN":
+      value = p.givenName;
+      break;
+    case "FULL_NAME":
+      value = name(p.familyName, p.givenName, format, full);
+      break;
+    case "FAMILY_KANA":
+      value = p.familyKana && kana(p.familyKana, format);
+      break;
+    case "GIVEN_KANA":
+      value = p.givenKana && kana(p.givenKana, format);
+      break;
+    case "FULL_KANA": {
+      const n = name(p.familyKana, p.givenKana, format, full);
+      value = n && kana(n, format);
+      break;
+    }
+    case "POSTAL": {
+      const parts = postalParts(p);
+      value = parts && digits(parts);
+      break;
+    }
+    case "POSTAL_1":
+      value = postalParts(p)?.[0];
+      break;
+    case "POSTAL_2":
+      value = postalParts(p)?.[1];
+      break;
+    case "PHONE":
