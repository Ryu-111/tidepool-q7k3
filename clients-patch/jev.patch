+      break;
+    case "PHONE_1":
+    case "PHONE_2":
+    case "PHONE_3":
+      value = p.phoneParts?.[Number(kind.slice(-1)) - 1];
+      break;
+    case "BIRTHDATE":
+      return birth ? birthdate(birth, format, shape, full) : null;
+    case "BIRTH_YEAR":
+      value = birth && (format.era && !numeric ? eraYear(birth) : String(birth.year));
+      break;
+    case "BIRTH_MONTH":
+      value = birth && pad(birth.month, format.datePad === true);
+      break;
+    case "BIRTH_DAY":
+      value = birth && pad(birth.day, format.datePad === true);
+      break;
+    case "BIRTH_ERA":
+      value = birth && eraName(birth);
+      break;
+    case "BIRTH_ERA_YEAR":
+      value = birth && eraYear(birth).slice(2);
+      break;
+    case "AGE":
+      value = birth && String(age(birth, today));
+      break;
+    case "GENDER":
+      value = p.gender && genderText[p.gender];
+      break;
+    case "COUNTRY":
+      value = p.country && (japan.has(fold(p.country)) ? "日本" : p.country);
+      break;
+    case "COMPANY":
+      value = p.company;
+      break;
+    case "DEPARTMENT":
+      value = p.department;
+      break;
+    case "JOB_TITLE":
+      value = p.jobTitle;
+      break;
+    case "EMAIL":
+      return p.email ? fits(p.email, format) : null;
+    case "USERNAME":
+      return p.username ? fits(p.username, format) : null;
+    case "PASSWORD":
+    case "UNKNOWN":
+      return null;
+    default:
+      value = address(maskOf(kind), p, format.blockKanji, full);
+  }
+  if (!value) {
+    return null;
+  }
+  value = width(value, format, full);
+  // A name without separator evidence may drop the space to fit a short field; other values are
+  // never shortened: a truncated address is worse than an empty field.
+  const mayDropSpace =
