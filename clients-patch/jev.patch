+      if (
+        r.width < 4 ||
+        r.height < 4 ||
+        r.right + scrollX <= 0 ||
+        r.bottom + scrollY <= 0 ||
+        r.left + scrollX >= Math.max(document.documentElement.scrollWidth, innerWidth) ||
+        r.top + scrollY >= Math.max(document.documentElement.scrollHeight, innerHeight)
