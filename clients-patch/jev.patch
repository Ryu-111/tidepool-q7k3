+        "準備できませんでした。サイト・保管庫・項目の選択を確認してください。入力はしていません。";
+    } finally {
+      this.state.busy = false;
+      this.changeDetector.markForCheck();
+    }
+  }
+
+  /**
+   * Asks Jev about the fields the on-device rules could not decide. Jev receives only the page's
+   * text about each field; a missing key or a failed request leaves those fields unfilled.
+   */
+  private async askJevIfNeeded(
+    fields: JevPageResult["fields"],
+    epoch: number,
+  ): Promise<Record<number, JevAnswer>> {
+    this.state.jevNote = "";
+    if (!needsJev(fields)) {
+      return {};
+    }
+    let apiKey = "";
+    try {
+      apiKey = await this.keyStore.get();
+    } catch {
+      apiKey = "";
+    }
+    if (!apiKey) {
+      this.state.jevNote = "Jevのキーが未設定のため、端末内の判定だけで入力しました。";
+      return {};
+    }
+    const controller = new AbortController();
+    this.context.abort = controller;
+    const timer = setTimeout(() => controller.abort(), 20_000);
+    try {
+      const answers = await askJev(fields, apiKey, controller.signal);
+      await this.checkContext(epoch);
+      return answers;
+    } catch {
+      await this.checkContext(epoch);
+      this.state.jevNote = "Jevに問い合わせできませんでした。端末内の判定だけで入力しました。";
+      return {};
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+
+  async saveKey() {
+    const key = this.state.apiKey.trim();
+    this.state.apiKey = "";
+    if (!API_KEY_PATTERN.test(key)) {
+      this.state.jevNote = "キーの形式が正しくありません。保存していません。";
+      return;
+    }
+    await this.keyStore.set(key);
+    this.state.keySaved = true;
+    this.state.jevNote = "Jevのキーを保存しました。";
+    this.changeDetector.markForCheck();
+  }
+
+  async clearKey() {
+    this.state.apiKey = "";
+    await this.keyStore.set(null);
+    this.state.keySaved = false;
+    this.state.jevNote = "Jevのキーを削除しました。";
+    this.changeDetector.markForCheck();
+  }
+
+  async fill() {
+    if (!this.context.snapshot || this.state.busy) {
+      return;
+    }
+    const epoch = this.context.epoch;
+    this.state.busy = true;
+    try {
+      await this.checkContext(epoch);
+      const ids = [this.state.identityId, this.state.loginId].filter(Boolean);
+      const selected = await this.ciphers.getAllDecryptedForIds(this.context.userId!, ids);
+      if (
+        JSON.stringify(this.selectedValues(selected)) !== JSON.stringify(this.context.values) ||
+        this.repromptIds(selected) !== this.context.repromptIds
+      ) {
+        throw new Error();
+      }
+      await this.checkContext(epoch);
+      const entries = this.state.rows
+        .filter((r) => r.approved && r.value !== null)
+        .map((r) => ({
+          id: r.field.id,
+          value: r.value!,
+          overwrite: r.field.occupied,
+        }));
+      const result = await BrowserApi.executeFunctionInTab(this.context.tab!.id!, jevPage, [
+        {
+          action: "fill",
+          url: this.context.snapshot.url,
+          token: this.context.snapshot.token,
+          entries,
+          feedback: this.state.feedback.enabled
+            ? this.state.rows
+                .filter((r) => r.field.type.toLowerCase() !== "password")
+                .map((r) => ({
+                  id: r.field.id,
+                  kind: r.kind,
+                  source: r.source,
+                  confidence: this.context.jev[r.field.id]?.confidence ?? null,
+                }))
+            : undefined,
+        },
+      ]);
+      this.state.message = result
+        ? `${result.written}/${entries.length}欄を入力。ページによる変更を${result.changed}欄検出。内容を確認してから手動で送信してください。`
+        : "ページが変わったか承認が期限切れです。再度、欄を確認してください。";
+    } catch {
+      this.state.message = "入力結果を確認できませんでした。ページ上の内容を確認してください。";
+    } finally {
+      this.invalidate();
+      this.state.busy = false;
+      this.changeDetector.markForCheck();
+    }
+  }
+
+  /** Summarizes the recorded corrections and drops records beyond the limit. */
+  async loadFeedback() {
+    try {
+      const items = await this.feedbackStore.all();
+      const removed = overflowKeys(items);
+      await this.feedbackStore.remove(removed);
+      for (const key of removed) {
