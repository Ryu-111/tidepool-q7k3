+/** Number an option stands for: 1990 for "1990年(平成2年)" or "平成2年", 4 for "04" / "4月". */
+function optionNumber(option: string, year: boolean): number {
+  const numbers = (option.match(/[0-9]+/g) ?? ([] as string[]))
+    .filter((n) => n.length <= 4)
+    .map(Number);
+  if (year) {
+    const western = numbers.find((n) => n >= 1800);
+    if (western !== undefined) {
+      return western;
+    }
+    const m = option.match(/(令和|平成|昭和|大正|明治)([0-9]+|元)/);
+    return m ? westernYear(m[1], m[2] === "元" ? 1 : Number(m[2])) : -1;
+  }
+  if (!numbers.length && /^元年?$/.test(option)) {
+    return 1;
+  }
+  return numbers.length === 1 ? numbers[0] : -1;
+}
