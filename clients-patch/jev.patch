+
+  ngOnInit() {
+    combineLatest([this.accounts.activeAccount$, this.auth.activeAccountStatus$])
+      .pipe(takeUntil(this.destroyed$))
+      .subscribe(([account, status]) => {
+        if (
+          status !== AuthenticationStatus.Unlocked ||
+          (this.context.userId && account?.id !== this.context.userId)
+        ) {
+          this.invalidate();
+          this.state.apiKey = "";
+          this.changeDetector.markForCheck();
+          this.state.identities = [];
+          this.state.logins = [];
+          this.state.message =
+            "保管庫がロックされたか、アカウントが変わりました。画面を開き直してください。";
+        }
+      });
+    void this.load();
+  }
+
+  private async load() {
+    await this.loadFeedback();
+    this.state.busy = true;
+    try {
+      this.state.keySaved = !!(await this.keyStore.get());
+    } catch {
+      this.state.keySaved = false;
+    }
+    const epoch = this.context.epoch;
+    try {
+      const account = await firstValueFrom(this.accounts.activeAccount$);
+      if (!account) {
+        throw new Error();
+      }
+      this.context.userId = account.id;
+      const tab = await BrowserApi.getTabFromCurrentWindow();
+      if (!tab?.id || !tab.url || new URL(tab.url).protocol !== "https:") {
+        throw new Error();
+      }
+      this.context.tab = tab;
+      this.state.origin = new URL(tab.url).origin;
+      await this.checkContext(epoch);
+      const ciphers = await this.ciphers.getAllDecrypted(account.id);
+      await this.checkContext(epoch);
+      const active = ciphers.filter((c) => !c.isDeleted && !c.isArchived);
+      this.state.identities = active
+        .filter((c) => c.type === CipherType.Identity)
+        .map(({ id, name }) => ({ id, name }));
+      this.state.logins = active
+        .filter((c) => this.matchesLogin(c))
+        .map(({ id, name }) => ({ id, name }));
+      this.state.identityId = this.defaultIdentityId();
+    } catch {
+      this.state.message =
+        "解錠済みの保管庫と、入力を許可したHTTPSページを開いてからやり直してください。";
+    } finally {
+      this.state.busy = false;
+      this.changeDetector.markForCheck();
+    }
+    if (this.options.autoFillOnOpen && this.state.identityId) {
+      await this.quickFill();
+    }
+  }
+
+  /** The last profile used here if it still exists, else the only one. */
+  private defaultIdentityId(): string {
+    const ids = this.state.identities.map((i) => i.id);
+    let last: string | null = null;
+    try {
+      last = localStorage.getItem(LAST_IDENTITY_KEY);
+    } catch {
+      // Storage may be unavailable; fall back to the single-profile rule.
+    }
+    if (last && ids.includes(last)) {
+      return last;
+    }
+    return ids.length === 1 ? ids[0] : "";
+  }
+
+  /**
+   * Fills every recognized, empty field at once. Fields that already hold a value are left as
+   * they are, and nothing is submitted.
+   */
+  async quickFill() {
+    this.state.filled = [];
+    this.state.skipped = [];
+    await this.prepare();
+    const rows = this.state.rows;
+    if (!rows.length) {
+      return;
+    }
+    const label = (row: JevRow) => {
+      const f = row.field;
+      const text = (f.caption || f.ariaLabel || f.placeholder || f.context || f.name || "")
+        .replace(/\s+/g, " ")
+        .trim()
+        .slice(0, 40);
+      return (text || `欄 ${f.id + 1}`) + (row.source === "jev" ? "［Jev］" : "");
+    };
+    for (const row of rows) {
+      row.approved = row.value !== null && !row.field.occupied;
+    }
+    const filled = rows.filter((r) => r.approved).map(label);
+    const skipped = rows
+      .filter((r) => !r.approved)
+      .map(
+        (r) =>
+          `${label(r)}（${
+            r.field.occupied
+              ? "入力済みのため変更せず"
+              : r.kind === "UNKNOWN"
+                ? "判定できず"
+                : "プロフィールに値がないか、欄の形式に合わない"
+          }）`,
+      );
+    if (!filled.length) {
+      this.invalidate();
+      this.state.skipped = skipped;
+      this.state.message = "入力できる空欄が見つかりませんでした。";
+      return;
+    }
+    try {
+      localStorage.setItem(LAST_IDENTITY_KEY, this.state.identityId);
+    } catch {
+      // Remembering the profile is a convenience only.
+    }
+    await this.fill();
+    this.state.filled = filled;
+    this.state.skipped = skipped;
+    this.changeDetector.markForCheck();
+  }
+
+  private matchesLogin(cipher: CipherView): boolean {
+    return (
+      cipher.type === CipherType.Login &&
+      cipher.viewPassword &&
+      !!cipher.login?.uris?.some((uri) => {
+        if (
+          !uri.uri ||
+          uri.match === UriMatchStrategy.Never ||
+          uri.match === UriMatchStrategy.RegularExpression
+        ) {
+          return false;
+        }
+        try {
+          const url = new URL(uri.uri);
+          return (
+            url.protocol === "https:" &&
+            !url.username &&
+            !url.password &&
+            url.origin === this.state.origin &&
+            (uri.match !== UriMatchStrategy.Exact || uri.uri === this.context.tab?.url) &&
+            (uri.match !== UriMatchStrategy.StartsWith ||
+              this.context.tab?.url?.startsWith(uri.uri))
+          );
+        } catch {
+          return false;
+        }
+      })
+    );
+  }
+
+  private async checkContext(epoch: number) {
+    const account = await firstValueFrom(this.accounts.activeAccount$);
+    const status = await firstValueFrom(this.auth.activeAccountStatus$);
+    const blocked = await firstValueFrom(this.domains.blockedInteractionsUris$);
+    const tab = this.context.tab?.id ? await BrowserApi.getTab(this.context.tab.id) : undefined;
+    if (
+      this.context.destroyed ||
+      epoch !== this.context.epoch ||
+      !this.context.userId ||
+      account?.id !== this.context.userId ||
+      status !== AuthenticationStatus.Unlocked ||
+      !tab?.url ||
+      tab.url !== this.context.tab?.url ||
+      new URL(tab.url).protocol !== "https:" ||
+      (blocked && isUrlInList(tab.url, blocked))
+    ) {
+      throw new Error();
+    }
+  }
+
+  invalidate() {
+    const tab = this.context.tab;
+    const snapshot = this.context.snapshot;
+    this.context.epoch++;
+    this.context.abort?.abort();
+    this.state.rows = [];
+    this.context.values = undefined;
+    this.context.snapshot = undefined;
+    if (tab?.id && tab.url && snapshot) {
+      void BrowserApi.executeFunctionInTab(tab.id, jevPage, [
+        { action: "clear", url: tab.url, token: snapshot.token },
+      ]).catch((): void => {});
+    }
+  }
+
+  private repromptIds(selected: CipherView[]): string {
+    return selected
+      .filter((c) => c.reprompt !== CipherRepromptType.None)
+      .map((c) => c.id)
+      .sort()
+      .join(",");
+  }
+
+  private selectedValues(selected: CipherView[]): SelectedValues {
+    const ids = [this.state.identityId, this.state.loginId].filter(Boolean);
+    if (
+      selected.length !== ids.length ||
+      selected.some((c) => !ids.includes(c.id) || c.isDeleted || c.isArchived)
+    ) {
+      throw new Error();
+    }
+    const identity = selected.find(
+      (c) => c.id === this.state.identityId && c.type === CipherType.Identity,
+    );
+    const login = selected.find((c) => c.id === this.state.loginId);
+    if ((this.state.identityId && !identity) || (login && !this.matchesLogin(login))) {
+      throw new Error();
+    }
+    return {
+      profile: (identity && toJevProfile(identity)) || {},
+      login: login?.login
+        ? { username: login.login.username ?? "", password: login.login.password ?? "" }
+        : undefined,
+    };
+  }
+
+  async prepare() {
+    this.invalidate();
+    const epoch = this.context.epoch;
+    this.state.busy = true;
+    this.state.message = "";
+    try {
+      await this.checkContext(epoch);
+      const ids = [this.state.identityId, this.state.loginId].filter(Boolean);
+      if (!ids.length) {
+        throw new Error();
+      }
+      const selected = await this.ciphers.getAllDecryptedForIds(this.context.userId!, ids);
+      if (selected.length !== ids.length || selected.some((c) => c.isDeleted || c.isArchived)) {
+        throw new Error();
+      }
+      if (
+        selected.some((c) => c.reprompt !== CipherRepromptType.None) &&
+        !(await this.reprompt.showPasswordPrompt())
