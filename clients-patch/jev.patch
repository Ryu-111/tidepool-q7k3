+export class JevComponent implements OnInit, OnDestroy {
+  readonly state = {
+    identities: [] as { id: string; name: string }[],
+    logins: [] as { id: string; name: string }[],
+    identityId: "",
+    loginId: "",
+    origin: "",
+    rows: [] as JevRow[],
+    apiKey: "",
+    keySaved: false,
+    /** Whether the last fill used Jev, or why it could not. */
+    jevNote: "",
+    busy: false,
+    message: "",
+    /** What the last fill wrote and skipped, for the result list. */
