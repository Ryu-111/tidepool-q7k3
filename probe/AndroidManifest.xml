<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.ryu.jevprobe" android:versionCode="1" android:versionName="0.1-probe">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Jev 検証用・ダミー専用" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".ConfirmActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".FixtureActivity" android:exported="false" />
        <service android:name=".ProbeService" android:exported="true" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
